# Four independent camera streams (local files, RTSP, HLS, or HTTP)
CAMERA_1_URL=assets/camera_1.mp4
CAMERA_2_URL=assets/camera_2.mp4
CAMERA_3_URL=assets/camera_3.mp4
CAMERA_4_URL=assets/camera_4.mp4

# Model weights (paths relative to demo-app/ or absolute)
MODEL_ENTITY=yolo11m.pt
MODEL_FIRE=data/models/fire_smoke_yolov5.pt
MODEL_WEAPON=data/models/weapons_yolov8.pt

# Detection confidence thresholds
CONF_ENTITY=0.5
CONF_FIRE=0.4
CONF_WEAPON=0.4

# Inference: fire + weapon only (entity/COCO detection off for now)
ENABLE_ENTITY_DETECTION=false
USE_CUDA=true
CUDA_DEVICE=0

# Adaptive scheduler baseline FPS per tile
BASE_FPS=15

# Face pipeline tuning (see docs/PIPELINE_OPTIMIZATIONS.md)
FACIAL_REC_INTERVAL=5
FACIAL_REC_INTERVAL_MAX=30
ADAPTIVE_FACIAL_THROTTLE=true
PIPELINE_LAG_THRESHOLD_MS=150
MIN_PERSON_BOX=40
PERSON_USE_TRT=true
WEAPON_HALF=true
WEAPON_IMGSZ=640

# Server
API_HOST=0.0.0.0
API_PORT=8001
