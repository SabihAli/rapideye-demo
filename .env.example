# Four independent camera streams (local files, RTSP, HLS, or HTTP)
CAMERA_1_URL=assets/camera_1.mp4
CAMERA_2_URL=assets/camera_2.mp4
CAMERA_3_URL=assets/camera_3.mp4
CAMERA_4_URL=assets/camera_4.mp4

# Model weights / exports
MODEL_ENTITY=yolo11m.pt
MODEL_PERSON=yolo11n.pt
MODEL_FIRE=data/models/fire_smoke_yolov5.pt
MODEL_WEAPON=data/models/weapons_yolov8.pt

# Detector thresholds
CONF_ENTITY=0.5
CONF_FIRE=0.4
CONF_WEAPON=0.4
PERSON_CONF=0.25

# Runtime
ENABLE_ENTITY_DETECTION=false
USE_CUDA=true
CUDA_DEVICE=0
BASE_FPS=30

# ONNX Runtime / TensorRT
TRT_ENABLE=true
TRT_FP16=true
INT8_DETECTORS=false
ORT_MAX_BATCH=8

# NVDEC decode
NVDEC_ENABLE=true

# Person stage
PERSON_IMGSZ=640
PERSON_INTERVAL_MIN=2
PERSON_INTERVAL_MAX=2
PERSON_INTERVAL_MAX_CEILING=2
TRACK_CONF_LOW=0.5
TRACK_CONF_HIGH=0.7
MIN_PERSON_BOX=40

# Tracking (ByteTrack, shared by person + fire trackers)
TRACK_BUFFER=30
TRACK_HIGH_THRESH=0.4
TRACK_LOW_THRESH=0.1
TRACK_NEW_THRESH=0.6
TRACK_MATCH_THRESH=0.8

# Fire stage
FIRE_IMGSZ=640
FIRE_DET_INTERVAL=2
FIRE_DET_INTERVAL_MAX=2

# Alerting debounce (consecutive frames to arm/disarm a zone alert)
ALERT_TRIGGER_FRAMES=5
ALERT_CLEAR_FRAMES=20

# Clip / recording lifecycle
CLIP_WRITER_WORKERS=3
RECORDINGS_RETENTION_DAYS=30
RECORDINGS_CLEANUP_INTERVAL_SEC=3600

# Weapon stage
WEAPON_IMGSZ=640
WEAPON_CROP_PADDING=0.25
WEAPON_MIN_CROP_PX=48

# Motion gating
MOTION_ENABLED=true
MOTION_DOWNSCALE_WIDTH=320
MOTION_PIXEL_DELTA=25
MOTION_AREA_RATIO=0.003
MOTION_COOLDOWN_SEC=2.0

# Face recognition
INSIGHTFACE_MODEL=buffalo_l
# Optional lighter pack:
# INSIGHTFACE_MODEL=buffalo_m
INSIGHTFACE_DET_SIZE=640
FACIAL_REC_INTERVAL=5
FACIAL_REC_INTERVAL_MAX=30
ADAPTIVE_FACIAL_THROTTLE=true
PIPELINE_LAG_THRESHOLD_MS=150
FACIAL_MATCH_THRESHOLD=0.4

# Server
API_HOST=0.0.0.0
API_PORT=8001
